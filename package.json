{
  "name": "seshat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Private self-hosted mapping app — multi-layer map viewer (GaiaGPS-style) + route planner (RideWithGPS-style).",
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "dev:api": "npm run dev --workspace api",
    "build": "npm run build --workspace web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
