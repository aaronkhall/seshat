# Seshat environment — copy to .env and fill in. Never commit .env.
# All keys are for FREE tiers of keyed tile sources, proxied by the api so they
# never reach the browser.

# Thunderforest (Outdoors / OpenCycleMap / Landscape) — free "Hobby" tier, 150k tiles/mo
# Sign up: https://www.thunderforest.com/
THUNDERFOREST_API_KEY=

# OpenWeatherMap weather tiles (wind / temp / clouds / precip) — free tier, 1M calls/mo
# Sign up: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=

# Port the api tile-proxy listens on (web dev server proxies /api -> here)
API_PORT=8787
