# Seshat environment — copy to .env and fill in. Never commit .env.
# All keys are for FREE tiers of keyed tile sources, proxied by the api so they
# never reach the browser.

# Thunderforest (Outdoors / OpenCycleMap / Landscape) — free "Hobby" tier, 150k tiles/mo
# Sign up: https://www.thunderforest.com/
THUNDERFOREST_API_KEY=

# OpenWeatherMap weather tiles (wind / temp / clouds / precip) — free tier, 1M calls/mo
# Sign up: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=

# Port the api tile-proxy listens on (web dev server proxies /api -> here)
API_PORT=8787

# --- Routing ---
# Self-hosted GraphHopper URL. Leave empty to use the keyless public OSRM servers
# everywhere. When set, routing is HYBRID: GraphHopper is used for routes fully
# inside GRAPHHOPPER_BBOX (native elevation + surface), public OSRM everywhere else.
# In docker compose use http://graphhopper:8989; on the host use http://localhost:8989.
GRAPHHOPPER_URL=

# Region your GraphHopper graph covers, as "w,s,e,n". Defaults to Australia
# (incl. Tasmania): 112,-44,154,-9. Set this to match whatever extract you imported.
GRAPHHOPPER_BBOX=112,-44,154,-9
